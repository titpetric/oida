package view

// Login renders the sign in screen. It draws none of the recorded data,
// because the requester has not proven they may see it, and the layout keeps
// its chrome folded away for this view.
templ login(page Page) {
	@Layout(page) {
		<section class="login">
			<h2>Sign in</h2>
			<p>This dashboard is protected.<br/>Sign in to view traces.</p>
			if page.LoginError != "" {
				<p class="login-error" role="alert">{ page.LoginError }</p>
			}
			<form method="post" action={ templ.SafeURL(page.LoginPath()) }>
				if page.LoginBack != "" {
					<input type="hidden" name="back" value={ page.LoginBack }/>
				}
				<span class="field">
					<label for="oida-username">Username</label>
					<input type="text" name="username" id="oida-username" value={ page.LoginUsername } autocomplete="username" autofocus/>
				</span>
				<span class="field">
					<label for="oida-password">Password</label>
					<input type="password" name="password" id="oida-password" autocomplete="current-password"/>
				</span>
				<button type="submit">Sign in</button>
			</form>
		</section>
	}
}
