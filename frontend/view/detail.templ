package view

import (
	"strconv"

	"github.com/titpetric/oida/model"
)

// Detail renders one trace: what it was, where the time went, and what it did.
templ detail(page Page) {
	@Layout(page) {
		if page.Trace != nil {
			<div class="trace-head">
				<div class="trace-primary">
					<h1 title={ page.Trace.Name }>{ page.Trace.Name }</h1>
					<span class="elapsed">{ preciseText(page.Trace.Duration) }</span>
				</div>
				<div class="trace-meta">
					if page.Trace.HTTP != nil && page.Trace.HTTP.Status > 0 {
						<span class={ statusClass(page.Trace.HTTP.Status) }>{ strconv.Itoa(page.Trace.HTTP.Status) }</span>
					} else if page.Trace.ErrorText != "" {
						<span class="status s5xx">fail</span>
					} else {
						<span class="status job">job</span>
					}
					<span class="meta-sep" aria-hidden="true">·</span>
					@traceLink(*page.Trace, page)
					<span class="meta-sep" aria-hidden="true">·</span>
					<span class="trace-age">{ page.Age(page.Trace.StartedAt) }</span>
				</div>
			</div>
			if page.Trace.ErrorText != "" {
				<div class="error">{ page.Trace.ErrorText }</div>
			}
			<div class="live-head">
				<h2>Transaction</h2>
			</div>
			@waves(page)
			<div class="section-peek span-peek">
				<h2>Spans <b>{ strconv.Itoa(len(page.Rows)) }</b></h2>
				@sectionToggle("spans", "spans")
			</div>
			<noscript>
				<style>.spans tr.attr-row { display: table-row; }</style>
			</noscript>
			<div class="spans">
				<div class="scroll">
					<table>
						<thead>
							<tr>
								<th>Kind</th>
								<th class="num c-medium">Offset</th>
								<th class="num c-medium">Duration</th>
								if page.Memory.Spans {
									<th class="c-wide">Memory in use</th>
								}
								<th class="plot">Span of the request</th>
								<th class="flex">Name</th>
							</tr>
						</thead>
						<tbody>
							for _, row := range page.Rows {
								@spanRow(page, row)
							}
							if len(page.Rows) == 0 {
								<tr><td class="empty" colspan={ spanColumns(page) }><b>No spans</b>This trace recorded no spans of its own.</td></tr>
							}
						</tbody>
					</table>
				</div>
			</div>
			if page.Trace.DroppedSpans > 0 {
				<p class="note spans-note">
					{ strconv.Itoa(page.Trace.DroppedSpans) } spans were dropped: this trace hit Options.MaxSpansPerTrace.
				</p>
			}
			@traceLogs(page)
			if page.Memory.Spans {
				@memoryGraph(page)
			}
			@traceFacts(*page.Trace, page.Memory)
		}
	}
}

// timelineFoot renders what sits under the drawing of a trace: the time axis
// it was drawn against.
templ timelineFoot(page Page) {
	<div class="axis">
		for _, tick := range page.Ticks() {
			<span style={ offsetStyle(tick.Share) }>{ tick.Label }</span>
		}
	</div>
}

// sectionToggle renders a remembered disclosure beside the heading that names
// it. The stylesheet does the opening; the script only remembers the choice.
templ sectionToggle(name string, label string) {
	<label class="peek-toggle">
		<input type="checkbox" data-peek={ name } aria-label={ "Show " + label }/>
		<i aria-hidden="true"></i>
	</label>
}

// timelineLegend renders where the time went, by kind. It is exclusive time,
// each moment attributed to the innermost span running, which is the question
// the drawings do not answer and the span table does.
templ timelineLegend(page Page) {
	<div class="legend">
		for _, share := range page.KindShares() {
			<span>
				<i style={ kindBackground(share.Kind) }></i>
				<b>{ share.Kind.String() }</b>
				{ durationText(share.Duration) }, { percentText(share.Share) }
			</span>
		}
		if len(page.Segments) == 0 {
			<span>No timed span regions recorded.</span>
		}
	</div>
}

// spanRow renders one span of the trace against the shared time axis, and the
// hidden full-width row behind it that carries its attributes and its source.
// The memory column is drawn only when the trace recorded it.
templ spanRow(page Page, row SpanRow) {
	<tr class={ "span-row", templ.KV("root-span", row.ID == page.Rows[0].ID), templ.KV("has-attrs", hasSpanDetail(row)) } data-span={ strconv.Itoa(row.ID) }>
		<td><span class="kind" style={ kindStyle(row.Kind) }>{ row.Kind.String() }</span></td>
		<td class="num c-medium">{ preciseText(row.Offset) }</td>
		<td class="num c-medium">
			if row.Open {
				<span class="stream-status">open</span>
			} else {
				{ preciseText(row.Duration) }
			}
		</td>
		if page.Memory.Spans {
			<td class="c-wide">
				if row.HasMemory {
					<span class="share">
						<span class="bar solid"><span style={ shareStyle(page.Memory.ShareOf(row.Memory)) }></span></span>
						{ memoryText(row) }
					</span>
				}
			</td>
		}
		<td class="plot">
			<div class="bar plot">
				<span style={ rowBarStyle(row) }></span>
			</div>
		</td>
		<td class="flex">
			<span class="mobile-row">
				<span class="span-name" style={ indentStyle(row.Depth) } title={ row.Name }>
					if row.Depth > 0 {
						<span class="span-tree">{ treeGlyph(row) }</span>
					}
					{ row.Name }
				</span>
				<span class="mobile-time">
					if row.ID == page.Rows[0].ID {
						{ millisecondsText(page.Trace.Duration) }
					} else {
						{ millisecondsText(row.Offset - page.Rows[0].Offset) }
					}
				</span>
			</span>
			if hasSpanDetail(row) {
				<button type="button" class="attrs-hint" aria-expanded="false" aria-controls={ "span-attrs-" + strconv.Itoa(row.ID) }>{ attrsHint(row) }</button>
			}
			if row.ErrorText != "" {
				<span class="error">{ row.ErrorText }</span>
			}
		</td>
	</tr>
	if hasSpanDetail(row) {
		<tr class="attr-row" id={ "span-attrs-" + strconv.Itoa(row.ID) } data-span={ strconv.Itoa(row.ID) }>
			<td colspan={ spanColumns(page) }>
				<table class="attr-table">
					<tbody>
						for _, key := range sortedKeys(row.Attributes) {
							<tr>
								<th>{ key }</th>
								<td>
									if isQueryKey(key) {
										<code class="query">{ attributeText(row.Attributes[key]) }</code>
									} else {
										{ attributeValue(row.Attributes, key) }
									}
								</td>
							</tr>
						}
						if row.SourceText() != "" {
							<tr>
								<th>source</th>
								<td class="dim">{ row.SourceText() }</td>
							</tr>
						}
					</tbody>
				</table>
			</td>
		</tr>
	}
}

// traceFacts renders what is behind the trace as tables side by side: the
// request details, what the transaction recorded about itself, and the request
// cost. Each is labels on the left and values on the right, one row per
// property, so a label is always in the same place.
templ traceFacts(trace model.Trace, memory MemoryBudget) {
	<div class="facts">
		<div class="fact-group">
			<div class="section-peek">
				<h2>Request</h2>
				@sectionToggle("request", "request details")
			</div>
			<div class="detail-fold">
				<div class="detail-clip">
					<dl class="detail">
						<div>
							<dt>Started</dt>
							<dd>{ trace.StartedAt.Format("2006-01-02 15:04:05.000") }</dd>
						</div>
						<div>
							<dt>Last state</dt>
							<dd>{ trace.State.Label() }</dd>
						</div>
						if trace.HTTP != nil {
							<div>
								<dt>Method</dt>
								<dd>{ trace.HTTP.Method } · { trace.HTTP.Protocol }</dd>
							</div>
							<div>
								<dt>URI</dt>
								<dd>{ trace.HTTP.URI }</dd>
							</div>
							if trace.HTTP.Route != "" {
								<div>
									<dt>Route</dt>
									<dd>{ trace.HTTP.Route }</dd>
								</div>
							}
							<div>
								<dt>Host</dt>
								<dd>{ trace.HTTP.Host }</dd>
							</div>
							<div>
								<dt>Response</dt>
								<dd>{ signedBytesText(trace.HTTP.ResponseBytes) }</dd>
							</div>
							<div>
								<dt>Remote</dt>
								<dd>{ trace.HTTP.RemoteAddress }</dd>
							</div>
							if trace.HTTP.UserAgent != "" {
								<div>
									<dt>User agent</dt>
									<dd>{ trace.HTTP.UserAgent }</dd>
								</div>
							}
						}
					</dl>
				</div>
			</div>
		</div>
		<div class="fact-group">
			<div class="section-peek">
				<h2>Transaction</h2>
				@sectionToggle("transaction", "transaction details")
			</div>
			<div class="detail-fold">
				<div class="detail-clip">
					// What the transaction recorded about itself. A Go service can
					// leave this empty.
					if len(trace.Attributes) > 0 {
						<dl class="detail">
							for _, key := range sortedKeys(trace.Attributes) {
								<div>
									<dt>{ attributeLabel(key) }</dt>
									<dd>{ attributeValue(trace.Attributes, key) }</dd>
								</div>
							}
							if memory.HasLimit && memory.HasUsed && memory.Limit > 0 {
								<div>
									<dt>Of limit</dt>
									<dd>
										<span class="share">
											<span class="bar solid"><span style={ shareStyle(memory.Share) }></span></span>
											{ percentText(memory.Share) }
										</span>
									</dd>
								</div>
							}
							if memory.Spans && !memory.HasUsed {
								<div>
									<dt>Peak in spans</dt>
									<dd>{ signedBytesText(memory.Peak) }</dd>
								</div>
							}
						</dl>
					} else {
						<p class="note">Record transaction attributes to show them here.</p>
					}
				</div>
			</div>
		</div>
		<div class="fact-group">
			<div class="section-peek">
				<h2>System</h2>
				@sectionToggle("system", "system details")
			</div>
			<div class="detail-fold">
				<div class="detail-clip">
					<dl class="detail">
						if trace.Service != "" {
							<div>
								<dt>Service</dt>
								<dd>{ trace.Service }</dd>
							</div>
						}
						<div>
							<dt>Spans</dt>
							<dd>{ strconv.Itoa(len(trace.Spans)) }</dd>
						</div>
						<div>
							<dt>Heap Δ</dt>
							<dd>{ signedBytesText(trace.Memory.HeapDelta) }</dd>
						</div>
						<div>
							<dt>Allocated</dt>
							<dd>{ bytesText(trace.Memory.AllocatedBytes) } · { strconv.FormatUint(trace.Memory.Allocations, 10) } allocs</dd>
						</div>
						<div>
							<dt>GC</dt>
							<dd>{ strconv.FormatUint(uint64(trace.Memory.GCCycles), 10) } cycles · { durationText(trace.Memory.GCPause) }</dd>
						</div>
					</dl>
				</div>
			</div>
		</div>
	</div>
}
