package view

import (
	"strconv"

	"github.com/titpetric/oida/model"
)

// traceLogs renders the log lines a trace recorded, in write order, each
// linked to the span that was active when it was written. The panel follows
// the spans behind its own disclosure; without entries it says how to record
// one.
templ traceLogs(page Page) {
	if page.Trace != nil {
		<div class="section-peek log-peek">
			<h2>Log <b>{ strconv.Itoa(page.LogCount()) }</b></h2>
			@sectionToggle("logs", "log entries")
		</div>
		<div class="logs-panel">
			<div class="logs-clip">
				if len(page.Trace.Logs) > 0 {
					<div class="scroll">
						<table>
							<thead>
								<tr>
									<th class="num c-medium">Offset</th>
									<th>Level</th>
									<th class="dim c-wide">Span</th>
									<th class="flex">Message</th>
								</tr>
							</thead>
							<tbody>
								for _, entry := range page.Trace.Logs {
									@logRow(entry, page)
								}
							</tbody>
						</table>
					</div>
					if page.Trace.DroppedLogs > 0 {
						<p class="note">
							{ strconv.Itoa(page.Trace.DroppedLogs) } log entries were dropped: this trace hit Options.MaxSpansPerTrace.
						</p>
					}
				} else {
					<p class="logs-empty"><b>No log entries</b>Record one with span.Info or trace.Error; each entry links to the span that was active when it was written.</p>
				}
			</div>
		</div>
	}
}

// logRow renders one log entry: when it was written relative to the trace
// start, how loud it was, where it came from, and what it said. The span
// carries its kind in the kind's colour, the way the span table draws it;
// the level is only inked when it is an error, because level is the data.
templ logRow(entry model.LogEntry, page Page) {
	<tr>
		<td class="num c-medium">{ preciseText(page.LogOffset(entry)) }</td>
		<td><span class={ logLevelClass(entry.Level) }>{ entry.Level }</span></td>
		if span := page.LogSpan(entry); span != nil {
			<td class="c-wide"><span class="kind" style={ kindStyle(span.Kind) }>{ span.Kind.String() }</span></td>
		} else {
			<td class="dim c-wide"></td>
		}
		<td class="flex">
			<span class="mobile-row">
				<span class="log-copy">
					<span class="log-msg">{ entry.Message }</span>
					if len(entry.Attributes) > 0 {
						<br/>
					}
					for _, key := range sortedKeys(entry.Attributes) {
						<span class="log-attr">{ key }={ attributeValue(entry.Attributes, key) }</span>
					}
				</span>
				<span class="mobile-time">{ millisecondsText(page.LogOffset(entry)) }</span>
			</span>
		</td>
	</tr>
}
