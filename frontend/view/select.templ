package view

// selectField renders a dropdown. A native select cannot be styled past its
// own edge: the open menu belongs to the platform, so it arrives in the wrong
// font, the wrong colours and the wrong theme. This one is a button, a hidden
// input carrying the value, and a list of options.
//
// Without scripting the button is inert, so a native select is rendered inside
// a noscript block. Only one of the two is ever live, and only one submits.
templ selectField(field SelectField) {
	<span class="field">
		<label for={ field.ID }>{ field.Label }</label>
		<div class="select" data-select>
			<button
				type="button"
				class="select-button"
				id={ field.ID }
				aria-haspopup="listbox"
				aria-expanded="false"
			>
				<span class="select-value">{ field.Selected() }</span>
			</button>
			<input type="hidden" name={ field.Name } value={ field.Value }/>
			<ul class="select-menu" role="listbox" aria-label={ field.Label } hidden>
				for _, option := range field.Options {
					<li
						role="option"
						class={ templ.KV("selected", field.IsSelected(option)) }
						data-value={ option.Value }
						aria-selected={ ariaSelected(field.IsSelected(option)) }
						tabindex="-1"
					>
						<span>{ option.Label }</span>
						if option.Note != "" {
							<span class="note">{ option.Note }</span>
						}
					</li>
				}
			</ul>
		</div>
		<noscript>
			<select name={ field.Name } aria-label={ field.Label }>
				for _, option := range field.Options {
					<option value={ option.Value } selected?={ field.IsSelected(option) }>{ option.Label }</option>
				}
			</select>
		</noscript>
	</span>
}
