package view

// memoryGraph draws the memory the spans reported: one step line over the
// same stretch of time as the drawing above it. Each reading was taken as a
// span finished, so the line holds flat and moves where a span let go. That
// place is the point of the graph: not that the memory grew, but where.
//
// The limit joins the plot as a dashed reference line when it is close enough
// to share a scale with the readings. A transaction far under its limit is
// drawn to its own peak instead, so a small request never flattens into a
// sliver along the floor.
//
// The graph is plain SVG and needs no scripting. Hovering a stretch of the
// line names the span that ended it, through a native title; the exact
// figures stay in the memory column of the span table. The line runs the
// whole trace, opening at the first reading's level, with start, middle and
// end readings in the legend below it.
templ memoryGraph(page Page) {
	{{ series := page.MemorySeries() }}
	if len(series.Points) > 0 {
		<div class="section-peek">
			<h2>Memory</h2>
			@sectionToggle("memory", "memory")
		</div>
		<div class="detail-fold memory-fold">
			<div class="detail-clip">
				<div class="memory-graph">
					<svg viewBox="0 0 100 100" preserveAspectRatio="none" role="img" aria-label={ "Memory in use over the trace, " + page.Memory.summary() }>
						if series.Limited {
							<line class="limit" x1="0" y1={ series.limitY() } x2="100" y2={ series.limitY() } vector-effect="non-scaling-stroke"></line>
						}
						<path class="wash" d={ series.areaPath() }></path>
						<path class="line" d={ series.linePath() } vector-effect="non-scaling-stroke"></path>
						for i, point := range series.Points {
							<rect class="hit" x={ series.hitX(i) } y="0" width={ series.hitWidth(i) } height="100">
								<title>{ point.title() }</title>
							</rect>
						}
					</svg>
					<i class="mark" style={ series.Last().overlayStyle() } aria-hidden="true"></i>
					<span class="reading" style={ series.Last().overlayStyle() }>{ signedBytesText(series.Last().Bytes) }</span>
					if series.Limited {
						<span class="limit-note" style={ series.limitStyle() }>limit { signedBytesText(page.Memory.Limit) }</span>
					}
				</div>
				<div class="memory-legend">
					<span><small>Start</small>{ signedBytesText(series.at(0)) }</span>
					<span><small>Middle</small>{ signedBytesText(series.at(50)) }</span>
					<span><small>End</small>{ signedBytesText(series.at(100)) }</span>
				</div>
			</div>
		</div>
	}
}
