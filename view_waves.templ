package oida

// waves draws the trace, and is the only drawing of it there is.
//
// The trace read as audio: every span is a waveform laid along the stretch of
// the width it ran for, and the waves are overlaid so a moment with four spans
// open is brighter than a moment with one. The shape of a wave is not data. Its
// extent, its colour and how loud it runs are.
//
// With scripting off the canvas stays empty and the page carries on: the span
// table under it is the same trace in numbers, and it needs nothing.
templ waves(page Page) {
	<div class="waves">
		<canvas id="oida-waves" aria-hidden="true"></canvas>
		<noscript>
			<p class="note">The drawing needs scripting. The spans below it do not.</p>
		</noscript>
	</div>
	@templ.JSONScript("oida-waves-data", page.WaveTrace())
	@timelineFoot(page)
}
